# Copy to .env.local for local development. Set the same keys in Netlify (Site settings → Environment variables).

# Public site URL (no trailing slash) — used for auth redirects and metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: only if you add server-side admin routes that need elevated access (not used by default in this app)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional marketing
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/233000000000

# Admin password for /momo-admin (server-side only — do NOT use NEXT_PUBLIC_ prefix)
ADMIN_PASSWORD=your_secure_admin_password

# Optional: merchant numbers shown on /payment-instructions
# NEXT_PUBLIC_MOMO_MTN_NUMBER=054 123 4567
# NEXT_PUBLIC_MOMO_VODAFONE_NUMBER=020 987 6543
# NEXT_PUBLIC_MOMO_AIRTELTIGO_NUMBER=026 555 1234
